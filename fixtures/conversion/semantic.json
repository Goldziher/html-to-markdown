        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "semantic_definition_list",
      "title": "Definition list with term and description"
    }
  },
  {
    "id": "semantic_mark_highlight",
    "description": "Mark tag produces highlighted output",
    "input": {
      "html": "<p>This is <mark>highlighted text</mark> in a sentence.</p>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "highlighted text"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "semantic_mark_highlight",
      "title": "Mark tag produces highlighted output"
    }
  },
  {
    "id": "semantic_sub_superscript",
    "description": "Subscript and superscript elements are preserved in output",
    "input": {
      "html": "<p>H<sub>2</sub>O and E=mc<sup>2</sup></p>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "H",
          "2",
          "O",
          "E=mc"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "semantic_sub_superscript",
      "title": "Subscript and superscript elements are preserved in output"
    }
  },
  {
    "id": "semantic_abbr",
    "description": "Abbreviation element text is preserved",
    "input": {
      "html": "<p>The <abbr title=\"World Wide Web\">WWW</abbr> is global.</p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "WWW"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "semantic_abbr",
      "title": "Abbreviation element text is preserved"
    }
  },
  {
