  {
    "id": "options_hidden_content_drop_default",
    "description": "Drop writes no text of a hidden element or a template",
    "input": {
      "html": "<p>visible</p><div role=\"tabpanel\" hidden>tab two body</div><template><p>row template</p></template>",
      "options": {
        "hidden_content": "Drop"
      }
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "visible\n"
      }
    ],
