      "options": {
        "hidden_content": "Reachable"
      }
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "visible\n\ntab two body\n"
      }
    ],
    "docs": {
      "topic": "options",
      "stem": "options_hidden_content_reachable",
