{
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "name": "@xberg-io/html-to-markdown",
  "version": "3.18.6",
  "description": "High-performance HTML to Markdown converter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/html-to-markdown.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "index.d.ts", "*.node"],
  "optionalDependencies": {
    "@xberg-io/html-to-markdown-darwin-arm64": "3.18.6",
    "@xberg-io/html-to-markdown-darwin-x64": "3.18.6",
    "@xberg-io/html-to-markdown-linux-arm64-gnu": "3.18.6",
    "@xberg-io/html-to-markdown-linux-arm64-musl": "3.18.6",
    "@xberg-io/html-to-markdown-linux-x64-gnu": "3.18.6",
    "@xberg-io/html-to-markdown-linux-x64-musl": "3.18.6",
    "@xberg-io/html-to-markdown-win32-arm64-msvc": "3.18.6",
    "@xberg-io/html-to-markdown-win32-x64-msvc": "3.18.6"
  },
  "napi": {
    "packageName": "@xberg-io/html-to-markdown",
    "binaryName": "html-to-markdown-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "pnpm --package @napi-rs/cli@^3.7.3 dlx napi build --platform --release",
    "artifacts": "pnpm --package @napi-rs/cli@^3.7.3 dlx napi artifacts",
    "prepublishOnly": "pnpm --package @napi-rs/cli@^3.7.3 dlx napi prepublish -t npm --skip-optional-publish"
  },
  "engines": {
    "node": ">= 22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8"
  },
  "packageManager": "pnpm@12.11.2"
}
