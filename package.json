{
  "name": "html-to-markdown-monorepo",
  "version": "3.18.4",
  "private": true,
  "description": "HTML to Markdown converter - monorepo root",
  "scripts": {
    "build": "pnpm run build:node && pnpm run build:wasm && pnpm run build:ts",
    "build:node": "pnpm --filter @xberg-io/html-to-markdown run build",
    "build:wasm": "pnpm --filter @xberg-io/html-to-markdown-wasm run build:all",
    "build:ts": "pnpm --filter @xberg-io/html-to-markdown run build",
    "test": "pnpm -r test",
    "test:node": "pnpm --filter @xberg-io/html-to-markdown test",
    "test:wasm": "pnpm --filter @xberg-io/html-to-markdown-wasm test",
    "test:ts": "pnpm --filter @xberg-io/html-to-markdown test",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "lint": "poly lint .",
    "format": "poly fmt --fix ."
  },
  "devDependencies": {
    "@textlint-rule/textlint-rule-no-invalid-control-character": "^3.0.0",
    "@types/node": "^26.6.5",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-filter-rule-node-types": "^1.1.0",
    "textlint-plugin-mdx": "^1.1.0",
    "textlint-rule-common-misspellings": "^1.0.1",
    "textlint-rule-no-empty-section": "^1.1.0",
    "textlint-rule-no-start-duplicated-conjunction": "^2.0.2",
    "textlint-rule-no-surrogate-pair": "^1.0.1",
    "textlint-rule-no-zero-width-spaces": "^1.0.1",
    "textlint-rule-stop-words": "^5.2.0",
    "textlint-rule-terminology": "^5.2.16",
    "textlint-rule-write-good": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.11.2",
  "pi": {
    "prompts": [
      "./plugin/.pi/prompts/html-to-markdown-convert.md",
      "./plugin/.pi/prompts/html-to-markdown-metadata.md"
    ],
    "skills": [
      "./plugin/.pi/skills/converting-html",
      "./plugin/.pi/skills/extracting-metadata",
      "./plugin/.pi/skills/extracting-tables",
      "./plugin/.pi/skills/fetching-and-converting-urls",
      "./plugin/.pi/skills/html-to-markdown",
      "./plugin/.pi/skills/using-the-mcp-server"
    ]
  }
}
