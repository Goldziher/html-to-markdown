{
  "name": "@xberg-io/html-to-markdown-cli",
  "version": "0.0.1",
  "description": "CLI proxy for html-to-markdown — downloads and runs the native html-to-markdown binary from GitHub releases.",
  "license": "MIT",
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/html-to-markdown.git",
    "directory": "cli-proxy/npm"
  },
  "bin": {
    "html-to-markdown": "bin/html-to-markdown.js"
  },
  "files": ["bin/", "install.js"],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.11.2"
}
